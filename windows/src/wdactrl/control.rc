#include "resource.h"
#include <winres.h>

IDD_CONTROL_PANEL DIALOGEX 0, 0, 260, 105
STYLE DS_SETFONT | DS_CENTER | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WineDirectALSA Control Panel"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Output device:", IDC_STATIC,
                    10, 12, 70, 10

    COMBOBOX        IDC_OUTPUT_DEVICE,
                    10, 25, 240, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Input device:", IDC_STATIC,
                    10, 37, 70, 10

    COMBOBOX        IDC_INPUT_DEVICE,
                    10, 50, 240, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    PUSHBUTTON      "Refresh", IDC_REFRESH,
                    10, 82, 50, 14

    DEFPUSHBUTTON   "OK", IDOK,
                    140, 82, 50, 14

    PUSHBUTTON      "Cancel", IDCANCEL,
                    200, 82, 50, 14
END
